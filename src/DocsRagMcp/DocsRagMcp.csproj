<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DocsRagMcp</RootNamespace>
    <AssemblyName>DocsRagMcp</AssemblyName>

    <!-- A .NET tool with the McpServer package type, so it can be started with `dnx DocsRagMcp` -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>docs-rag-mcp</ToolCommandName>
    <PackageType>McpServer</PackageType>

    <PackageId>DocsRagMcp</PackageId>
    <Version>0.2.0</Version>
    <Authors>Ahmed Manai</Authors>
    <Description>MCP server that lets Claude, GitHub Copilot and Cursor search your own documents (Markdown, text, PDF) with RAG. Embeddings from Ollama, OpenAI or Azure OpenAI, stored in a local SQLite file.</Description>
    <PackageTags>mcp;model-context-protocol;rag;embeddings;semantic-search;ollama;openai;azure-openai;ai</PackageTags>
    <PackageProjectUrl>https://github.com/Ahmed-Manai/docs-rag-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ahmed-Manai/docs-rag-mcp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".mcp/server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DocsRagMcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="OllamaSharp" Version="5.5.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0" />
  </ItemGroup>

</Project>
